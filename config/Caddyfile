192.168.1.11:443 {
	tls internal
	encode zstd gzip

	log {
		output file /var/log/caddy/authentik-headers.log
		format json
	}

	@authentik_outpost path /outpost.goauthentik.io/*
	handle @authentik_outpost {
		reverse_proxy {$AUTHENTIK_URL}
	}

	handle {
		route {
			request_header -X-Authentik-Username
			request_header -X-Authentik-Groups
			request_header -X-Authentik-Email
			request_header -X-Authentik-Name
			request_header -X-Authentik-Uid

			forward_auth {$AUTHENTIK_URL} {
				uri /outpost.goauthentik.io/auth/caddy
				copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Entitlements X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version authorization
				trusted_proxies private_ranges
			}

			log_append ak_user {http.request.header.X-Authentik-Username}
			log_append ak_uid {http.request.header.X-Authentik-Uid}
			log_append ak_groups {http.request.header.X-Authentik-Groups}

			@api path /api/*
			handle @api {
				reverse_proxy 127.0.0.1:8000 {
					header_up -X-Remote-User
					header_up -X-Remote-Name
					header_up -X-Remote-Groups
					header_up -X-Remote-Guid
					header_up X-Remote-User {http.request.header.X-Authentik-Username}
					header_up X-Remote-Name {http.request.header.X-Authentik-Name}
					header_up X-Remote-Groups {http.request.header.X-Authentik-Groups}
					header_up X-Remote-Guid {http.request.header.X-Authentik-Uid}
				}
			}

			handle {
				root * /srv/labctl/apps/admin-app/build
				try_files {path} /200.html
				file_server
			}
		}
	}
}

students.cluster.castelli.local:443 {
	tls internal
	encode zstd gzip

	log {
		output file /var/log/caddy/authentik-headers.log
		format json
	}

	@authentik_outpost path /outpost.goauthentik.io/*
	handle @authentik_outpost {
		reverse_proxy {$AUTHENTIK_URL}
	}

	handle {
		route {
			request_header -X-Authentik-Username
			request_header -X-Authentik-Groups
			request_header -X-Authentik-Email
			request_header -X-Authentik-Name
			request_header -X-Authentik-Uid

			forward_auth {$AUTHENTIK_URL} {
				uri /outpost.goauthentik.io/auth/caddy
				copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Entitlements X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version authorization
